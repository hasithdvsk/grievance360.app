{
  "name": "grievance360-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise AI-Powered Grievance Redressal and Analytics Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@grievance360/web",
    "dev:web": "npm run dev --workspace=@grievance360/web",
