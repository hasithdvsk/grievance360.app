    "lint:web": "npm run lint --workspace=@grievance360/web",
    "docker:up": "docker-compose up --build",
    "docker:down": "docker-compose down"
  },
  "keywords": [
    "grievance-redressal",
    "fastapi",
    "nextjs",
    "celery",
    "monorepo",
    "sentence-transformers"
  ],
